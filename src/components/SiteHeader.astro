---
import { brand, navigation } from '@/data/product';

interface Props {
  home?: boolean;
}

const { home = true } = Astro.props;
const links = navigation.map((link) => ({
  label: link.label,
  href: home ? link.href : `/${link.href}`,
}));
---

<a class="skip-link" href="#main">
  Skip to content
</a>
<header class="site-header">
  <div class="wrap site-header__bar">
    <a class="wordmark" href={home ? '#reveal' : '/'} aria-label={`${brand.name}, back to the top`}>
      {brand.wordmark}
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
    >
      <span data-menu-label>Menu</span>
      <span class="menu-toggle__icon" aria-hidden="true"></span>
    </button>
    <nav class="site-nav" id="site-nav" aria-label="Main" data-menu>
      <ul class="site-nav__list">
        {links.map((link) => (
          <li>
            <a class="link-line" href={link.href} data-nav-link>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
