---
import '@/styles/global.css';
import { brand, product } from '@/data/product';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = `${product.fullName} | ${brand.name}`,
  description = product.description,
  noindex = false,
} = Astro.props;

const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const ogImage = site ? new URL('/og-image.jpg', site).href : '/og-image.jpg';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0b0a" />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (function () {
        const root = document.documentElement;
        root.classList.add('js');
        window.setTimeout(function () {
          if (!root.classList.contains('js-ready')) root.classList.remove('js');
        }, 5000);
      })();
    </script>
  </head>
  <body>
    <slot />
    <script src="../scripts/main.ts"></script>
  </body>
</html>
